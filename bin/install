#!/bin/bash
# =============================================================================
# AtoM Framework Installer v2.3
# Automates: table creation, symlinks, ProjectConfiguration, dist assets, themes
# =============================================================================

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}"
echo "=============================================="
echo "  AtoM Framework Installer v2.3"
echo "=============================================="
echo -e "${NC}"

# Detect paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FRAMEWORK_PATH="$(dirname "$SCRIPT_DIR")"
ATOM_ROOT="$(dirname "$FRAMEWORK_PATH")"

echo -e "${YELLOW}Paths detected:${NC}"
echo "  Framework: $FRAMEWORK_PATH"
echo "  AtoM Root: $ATOM_ROOT"

# -----------------------------------------------------------------------------
# Base AtoM patches are OPT-IN.
#
# patches/ holds 41 files that overwrite base AtoM. The AHG plugins do not need
# any of them: verified 2026-08-05 on a pristine AtoM checkout, where the full
# plugin set loads, renders and saves with zero modified AtoM files.
#
# They used to be copied unconditionally, which meant installing our plugins
# silently forked the customer's AtoM with two dozen files they never asked for -
# files that then have to be reapplied after every AtoM upgrade, and that make
# their install unsupportable by Artefactual. That is the opposite of what a
# plugin bundle should do.
#
# They remain available with --with-base-patches, which is what our own instances
# use, because several of them are fixes to base AtoM that we do want on the
# servers we operate.
# -----------------------------------------------------------------------------
APPLY_BASE_PATCHES=0
for _arg in "$@"; do
    case "$_arg" in
        --with-base-patches) APPLY_BASE_PATCHES=1 ;;
        --help|-h)
            echo ""
            echo "Usage: bin/install [--with-base-patches]"
            echo ""
            echo "  --with-base-patches   Also overwrite base AtoM files from patches/."
            echo "                        Not needed by the plugins. For AHG-operated"
            echo "                        servers only."
            exit 0
            ;;
    esac
done

if [ "$APPLY_BASE_PATCHES" = "1" ]; then
    echo -e "  ${YELLOW}Base patches: ENABLED (base AtoM files will be overwritten)${NC}"
else
    echo "  Base patches: disabled (base AtoM will not be modified)"
fi

# Get database credentials from config.php
CONFIG_FILE="${ATOM_ROOT}/config/config.php"
if [ ! -f "$CONFIG_FILE" ]; then
    echo -e "${RED}Error: config.php not found at $CONFIG_FILE${NC}"
    exit 1
fi

DB_HOST=$(php -r "\$c=require('${CONFIG_FILE}'); preg_match('/host=([^;]+)/', \$c['all']['propel']['param']['dsn'] ?? '', \$m); echo \$m[1] ?? 'localhost';")
DB_USER=$(php -r "\$c=require('${CONFIG_FILE}'); echo \$c['all']['propel']['param']['username'] ?? 'atom';")
DB_PASS=$(php -r "\$c=require('${CONFIG_FILE}'); echo \$c['all']['propel']['param']['password'] ?? '';")
DB_NAME=$(php -r "\$c=require('${CONFIG_FILE}'); preg_match('/dbname=([^;]+)/', \$c['all']['propel']['param']['dsn'] ?? '', \$m); echo \$m[1] ?? 'atom';")

echo -e "${YELLOW}Database:${NC} $DB_NAME @ $DB_HOST"

# MySQL command wrapper to suppress password warning
mysql_cmd() {
    mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" "$@" 2>/dev/null
}

mysql_cmd_file() {
    mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" < "$1" 2>/dev/null
}

# =============================================================================
# Step 1: Create database tables
# =============================================================================
echo ""
echo -e "${BLUE}Step 1: Creating database tables...${NC}"

INSTALL_SQL="${FRAMEWORK_PATH}/database/install.sql"

if [ -f "$INSTALL_SQL" ]; then
    echo -e "  ${YELLOW}→${NC} Running database/install.sql..."
    if mysql_cmd_file "$INSTALL_SQL"; then
        echo -e "  ${GREEN}✓${NC} Database tables created successfully"
    else
        echo -e "  ${RED}✗${NC} Error creating database tables"
        exit 1
    fi
else
    echo -e "  ${RED}✗${NC} install.sql not found at $INSTALL_SQL"
    exit 1
fi

echo -e "${GREEN}✓ Database tables created${NC}"

# =============================================================================
# Step 1b: Schema upgrades (safe ALTERs for existing deployments)
# =============================================================================
UPGRADE_SQL="${FRAMEWORK_PATH}/database/schema_upgrades.sql"
if [ -f "$UPGRADE_SQL" ]; then
    echo -e "  ${YELLOW}→${NC} Running schema upgrades..."
    if mysql_cmd_file "$UPGRADE_SQL"; then
        echo -e "  ${GREEN}✓${NC} Schema upgrades applied"
    else
        echo -e "  ${YELLOW}⚠${NC} Schema upgrades had warnings (may be expected)"
    fi
fi

# =============================================================================
# Step 2: Create plugin symlinks
# =============================================================================
echo ""
echo -e "${BLUE}Step 2: Creating plugin symlinks...${NC}"

AHG_PLUGINS="${ATOM_ROOT}/atom-ahg-plugins"
PLUGINS_DIR="${ATOM_ROOT}/plugins"

if [ -d "$AHG_PLUGINS" ]; then
    for plugin in $(ls -d ${AHG_PLUGINS}/ahg* 2>/dev/null | xargs -n1 basename); do
        if [ -d "${AHG_PLUGINS}/${plugin}" ]; then
            if [ ! -L "${PLUGINS_DIR}/${plugin}" ]; then
                ln -sf "${AHG_PLUGINS}/${plugin}" "${PLUGINS_DIR}/${plugin}"
                echo -e "  ${GREEN}✓${NC} Linked $plugin"
            else
                echo -e "  ${YELLOW}→${NC} $plugin already linked"
            fi
        fi
    done
else
    echo -e "${YELLOW}⚠ atom-ahg-plugins not found at $AHG_PLUGINS${NC}"
fi

# =============================================================================
# Step 3: Update ProjectConfiguration
# =============================================================================
echo ""
echo -e "${BLUE}Step 3: Updating ProjectConfiguration...${NC}"

PROJECT_CONFIG="${ATOM_ROOT}/config/ProjectConfiguration.class.php"
TEMPLATE_CONFIG="${FRAMEWORK_PATH}/config/ProjectConfiguration.class.php.template"

# ProjectConfiguration is a base AtoM file, and the plugins no longer need it
# touched.
#
# AtoM already loads plugins from the database: sfPluginAdminPlugin reads the
# `plugins` setting and enables what it finds. The only thing that was missing
# was the framework autoloader, and ahgCorePluginConfiguration now registers
# that itself. Verified 2026-08-05 against a pristine AtoM 2.10.1: the full
# plugin set loads and every page is byte-identical to a patched install.
#
# Overwriting it was also the step that made this installer fail hard on a
# stock AtoM, where the file is root-owned and www-data cannot write it. The
# script aborted under `set -e` at this point, leaving an install that had
# symlinked plugins and done nothing else.
if [ "$APPLY_BASE_PATCHES" != "1" ]; then
    echo "  → Left untouched. Plugin loading does not require it;"
    echo "    ahgCorePlugin bootstraps the framework itself."
elif grep -q "loadPluginsFromDatabase" "$PROJECT_CONFIG"; then
    echo -e "  ${YELLOW}→${NC} ProjectConfiguration already has database plugin loading"
elif [ ! -w "$PROJECT_CONFIG" ]; then
    echo -e "  ${YELLOW}⚠${NC} ${PROJECT_CONFIG} is not writable by $(id -un) - skipping."
    echo "     Re-run as a user that can write it, or drop --with-base-patches."
else
    cp "$PROJECT_CONFIG" "${PROJECT_CONFIG}.bak.$(date +%Y%m%d_%H%M%S)"
    echo -e "  ${GREEN}✓${NC} Backed up existing ProjectConfiguration"
    cp "$TEMPLATE_CONFIG" "$PROJECT_CONFIG"
    if [ -f "${ATOM_ROOT}/vendor/autoload.php" ]; then
        sed -i "s|vendor/composer/autoload.php|vendor/autoload.php|" "$PROJECT_CONFIG"
    fi
    echo -e "  ${GREEN}✓${NC} Installed ProjectConfiguration with database plugin loading"
fi

# =============================================================================
# Step 4: Copy dist assets
# =============================================================================
echo ""
echo -e "${BLUE}Step 4: Copying dist assets...${NC}"

DIST_DIR="${ATOM_ROOT}/dist"
mkdir -p "${DIST_DIR}/css" "${DIST_DIR}/js"

if [ -d "${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist" ]; then
    cp -f ${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist/css/* ${DIST_DIR}/css/ 2>/dev/null && echo -e "  ${GREEN}✓${NC} Copied CSS assets" || echo -e "  ${YELLOW}→${NC} No CSS to copy"
    cp -f ${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist/js/* ${DIST_DIR}/js/ 2>/dev/null && echo -e "  ${GREEN}✓${NC} Copied JS assets" || echo -e "  ${YELLOW}→${NC} No JS to copy"
else
    echo -e "  ${YELLOW}⚠${NC} AHG theme dist folder not found"
fi

WATERMARK_DIR="${ATOM_ROOT}/images/watermarks"
if [ -d "${FRAMEWORK_PATH}/dist/images/watermarks" ]; then
    mkdir -p ${WATERMARK_DIR}
    cp -f ${FRAMEWORK_PATH}/dist/images/watermarks/* ${WATERMARK_DIR}/ 2>/dev/null
    chown -R www-data:www-data ${WATERMARK_DIR}
    echo -e "  ${GREEN}✓${NC} Copied watermark images"
else
    echo -e "  ${YELLOW}⚠${NC} Watermark images not found"
fi

# =============================================================================
# Step 5: Enable themes in setting_i18n
# =============================================================================
echo ""
echo -e "${BLUE}Step 5: Enabling themes and plugins...${NC}"

CURRENT_PLUGINS=$(mysql_cmd -N -e "SELECT value FROM setting_i18n WHERE id = 1;")

if echo "$CURRENT_PLUGINS" | grep -q "ahgThemeB5Plugin"; then
    echo -e "  ${YELLOW}→${NC} Plugins already configured"
else
    mysql_cmd -e "UPDATE setting_i18n SET value = 'a:17:{i:0;s:10:\"sfDcPlugin\";i:1;s:18:\"arDominionB5Plugin\";i:2;s:13:\"ahgCorePlugin\";i:3;s:16:\"ahgThemeB5Plugin\";i:4;s:26:\"ahgSecurityClearancePlugin\";i:5;s:11:\"sfEacPlugin\";i:6;s:11:\"sfEadPlugin\";i:7;s:13:\"sfIsaarPlugin\";i:8;s:12:\"sfIsadPlugin\";i:9;s:12:\"arDacsPlugin\";i:10;s:12:\"sfIsdfPlugin\";i:11;s:14:\"sfIsdiahPlugin\";i:12;s:12:\"sfModsPlugin\";i:13;s:11:\"sfRadPlugin\";i:14;s:12:\"sfSkosPlugin\";i:15;s:16:\"ahgDisplayPlugin\";i:16;s:17:\"ahgSettingsPlugin\";}' WHERE id = 1;"
    echo -e "  ${GREEN}✓${NC} Enabled core plugins"
fi

# =============================================================================
# Step 6: Clear cache
# =============================================================================
echo ""
echo -e "${BLUE}Step 6: Clearing cache...${NC}"

rm -rf ${ATOM_ROOT}/cache/*
echo -e "  ${GREEN}✓${NC} Cache cleared"

# =============================================================================
# Step 6b: Load plugin data files
# =============================================================================
echo ""
echo -e "${BLUE}Step 6b: Loading plugin data...${NC}"

# MVP plugins only - other plugins install their tables via:
#   php bin/atom extension:enable <name>
MVP_PLUGINS="ahgCorePlugin ahgThemeB5Plugin ahgSecurityClearancePlugin ahgDisplayPlugin ahgSettingsPlugin ahgAuditTrailPlugin ahgBackupPlugin"

for plugin in $MVP_PLUGINS; do
    DB_SQL="${AHG_PLUGINS}/${plugin}/database/install.sql"
    if [ -f "$DB_SQL" ]; then
        echo -e "  ${YELLOW}→${NC} Loading $plugin..."
        if mysql_cmd_file "$DB_SQL"; then
            echo -e "  ${GREEN}✓${NC} $plugin loaded"
        else
            echo -e "  ${YELLOW}⚠${NC} $plugin had warnings (may be expected)"
        fi
    else
        echo -e "  ${YELLOW}⚠${NC} $plugin has no database/install.sql"
    fi
done
echo -e "  Additional plugins: php bin/atom extension:enable <name>"

echo -e "${GREEN}✓ Plugin data loaded${NC}"

# =============================================================================
# Step 6c: Enable required default plugins
# =============================================================================
echo ""
echo -e "${BLUE}Step 6c: Enabling required plugins...${NC}"

# MVP plugins: locked/core + essential operational
mysql_cmd -e "
INSERT INTO atom_plugin (name, class_name, version, is_enabled, is_core, is_locked, load_order, category, description, created_at, updated_at) VALUES
('ahgCorePlugin', 'ahgCorePluginConfiguration', '1.0.0', 1, 1, 1, 5, 'ahg', 'Core framework plugin', NOW(), NOW()),
('ahgThemeB5Plugin', 'ahgThemeB5PluginConfiguration', '1.2.0', 0, 1, 1, 10, 'theme', 'Bootstrap 5 theme', NOW(), NOW()),
('ahgSecurityClearancePlugin', 'ahgSecurityClearancePluginConfiguration', '1.0.0', 1, 1, 1, 20, 'ahg', 'Security classification system', NOW(), NOW()),
('ahgDisplayPlugin', 'ahgDisplayPluginConfiguration', '1.0.0', 1, 1, 1, 30, 'ahg', 'GLAM browse and display profiles', NOW(), NOW()),
('ahgSettingsPlugin', 'ahgSettingsPluginConfiguration', '1.0.1', 1, 1, 1, 15, 'admin', 'Admin settings and plugin management', NOW(), NOW()),
('ahgAuditTrailPlugin', 'ahgAuditTrailPluginConfiguration', '1.0.0', 1, 0, 0, 40, 'ahg', 'Compliance audit trail', NOW(), NOW()),
('ahgBackupPlugin', 'ahgBackupPluginConfiguration', '1.0.0', 1, 0, 0, 50, 'ahg', 'Backup and restore', NOW(), NOW())
ON DUPLICATE KEY UPDATE is_enabled = 1, version = VALUES(version), updated_at = NOW();
"
echo -e "  ${GREEN}✓${NC} ahgCorePlugin enabled (locked)"
echo -e "  ${GREEN}✓${NC} ahgThemeB5Plugin enabled (locked)"
echo -e "  ${GREEN}✓${NC} ahgSecurityClearancePlugin enabled (locked)"
echo -e "  ${GREEN}✓${NC} ahgDisplayPlugin enabled (locked)"
echo -e "  ${GREEN}✓${NC} ahgSettingsPlugin enabled (locked)"
echo -e "  ${GREEN}✓${NC} ahgAuditTrailPlugin enabled"
echo -e "  ${GREEN}✓${NC} ahgBackupPlugin enabled"
echo ""
echo -e "  Additional plugins: ${YELLOW}php bin/atom extension:enable <name>${NC}"
echo -e "  Discover available: ${YELLOW}php bin/atom extension:discover${NC}"

# =============================================================================
# Step 6d: Sync plugin versions from extension.json
# =============================================================================
echo ""
echo -e "${BLUE}Step 6d: Syncing plugin versions...${NC}"

for plugin_dir in ${ATOM_ROOT}/atom-ahg-plugins/*Plugin; do
    if [ -d "$plugin_dir" ]; then
        plugin_name=$(basename "$plugin_dir")
        manifest="${plugin_dir}/extension.json"
        if [ -f "$manifest" ]; then
            version=$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$manifest" | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
            if [ -n "$version" ]; then
                mysql_cmd -e "UPDATE atom_plugin SET version = '$version' WHERE name = '$plugin_name' AND (version IS NULL OR version = '');" 2>/dev/null || true
            fi
        fi
    fi
done
echo -e "  ${GREEN}✓${NC} Plugin versions synced"

# =============================================================================
# Step 7: Patch QubitMetadataRoute for GLAM sector support
# =============================================================================
echo ""
echo -e "${BLUE}Step 7: Patching QubitMetadataRoute...${NC}"

# Copy the patch file rather than editing base in place (#261).
#
# This step used to run four `sed -i` inserts guarded by
# `grep -q "ahgLibraryPlugin"`. The file never contains that string - the seds
# insert 'library' => 'library', not the plugin name - so the guard was always
# false and every run re-inserted the four entries, duplicating them in
# $METADATA_PLUGINS and compounding on each install.
#
# It also meant patches/lib/routing/QubitMetadataRoute.class.php was a reference
# copy that was never actually applied, contrary to the patches convention, so
# edits to it silently did nothing.
#
# Copying is idempotent and makes the patch file authoritative.
ROUTE_PATCH="${FRAMEWORK_PATH}/patches/lib/routing/QubitMetadataRoute.class.php"
ROUTE_FILE="${ATOM_ROOT}/lib/routing/QubitMetadataRoute.class.php"
if [ "$APPLY_BASE_PATCHES" != "1" ]; then
    echo "  → QubitMetadataRoute patch skipped (base AtoM not modified)"
elif [ -f "$ROUTE_PATCH" ]; then
    cp -f "$ROUTE_PATCH" "$ROUTE_FILE"
    echo -e "  ${GREEN}✓${NC} Applied QubitMetadataRoute patch (GLAM sectors, RiC, edit routing)"
elif [ -f "$ROUTE_FILE" ]; then
    echo -e "  ${YELLOW}⚠${NC} No QubitMetadataRoute patch found - leaving base file untouched"
else
    echo -e "  ${YELLOW}⚠${NC} QubitMetadataRoute.class.php not found"
fi

# =============================================================================
# Complete
# =============================================================================
echo ""
echo -e "${GREEN}=============================================="
echo "  Installation Complete!"
echo "==============================================${NC}"
echo ""
echo "Next steps:"
echo "  1. Restart PHP-FPM: sudo systemctl restart php8.3-fpm"
echo "  2. Test the site"
echo ""
echo "To switch themes, go to Admin → Themes"
echo ""

# =============================================================================
# Step 10: Copy dist assets (icons)
# =============================================================================
echo ""
echo "Step 10: Copying dist assets..."

# Create dist/icons directory
mkdir -p "${ATOM_ROOT}/dist/icons"

# Copy icons from theme plugin
if [ -d "${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist/icons" ]; then
    cp -r "${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist/icons/"* "${ATOM_ROOT}/dist/icons/" 2>/dev/null
    echo "  ✓ Copied icons to dist/icons/"
else
    echo "  ⚠ No icons found in ahgThemeB5Plugin/web/dist/icons/"
fi


# =============================================================================
# Step 11: Apply AtoM core patches
# =============================================================================
echo ""
echo "Step 11: Applying AtoM core patches..."

if [ "$APPLY_BASE_PATCHES" != "1" ]; then
    echo "  → Skipped. Base AtoM is left exactly as installed."
    echo ""
    echo "    The plugins do not need these patches. Two things to be aware of:"
    echo ""
    echo "    1. patches/qbAclPlugin/ closes an upstream bypass where every user is"
    echo "       granted readMaster on TEXT objects, making PDF masters of draft,"
    echo "       embargoed and access-restricted records anonymously downloadable"
    echo "       (artefactual/atom#1724). That is a bug in AtoM, not in this bundle,"
    echo "       and it is present on a stock install whether or not you install us."
    echo "    2. patches/apps/qubit/config/security.yml and friends carry the AtoM"
    echo "       2.10.1 security fixes. If this AtoM predates 2.10.1, apply the"
    echo "       upstream release rather than our copies."
    echo ""
    echo "    Run with --with-base-patches to apply them anyway."
else

# Copy patched QubitAcl.class.php (Role 99 fix)
if [ -f "${FRAMEWORK_PATH}/patches/qbAclPlugin/lib/QubitAcl.class.php" ]; then
    cp -f "${FRAMEWORK_PATH}/patches/qbAclPlugin/lib/QubitAcl.class.php" \
          "${ATOM_ROOT}/plugins/qbAclPlugin/lib/QubitAcl.class.php"
    echo "  ✓ Applied QubitAcl patch (Role 99 fix)"
else
    echo "  ⚠ QubitAcl patch not found"
fi

# SECURITY (#258): close the text/PDF readMaster bypass.
#
# Upstream grants EVERY user readMaster on TEXT media objects, returning before
# both the standard ACL check and QubitGrantedRight::checkPremis - so PDF masters
# of draft, embargoed and access-restricted records are anonymously downloadable,
# and PREMIS Rights cannot restrict them (artefactual/atom#1724).
#
# These must be reapplied on every install: without them an upgrade silently
# reopens the bypass, and nothing warns you because the pages still work.
for aclPatch in QubitInformationObjectAcl QubitActorAcl; do
    if [ -f "${FRAMEWORK_PATH}/patches/qbAclPlugin/lib/${aclPatch}.class.php" ]; then
        cp -f "${FRAMEWORK_PATH}/patches/qbAclPlugin/lib/${aclPatch}.class.php" \
              "${ATOM_ROOT}/plugins/qbAclPlugin/lib/${aclPatch}.class.php"
        echo "  ✓ Applied ${aclPatch} patch (text/PDF readMaster bypass closed, #258)"
    else
        echo "  ⚠ ${aclPatch} patch not found - text/PDF master bypass may be OPEN"
    fi
done

# Apply base AtoM app patches (templates + actions)
PATCH_APPS="${FRAMEWORK_PATH}/patches/apps"
if [ -d "${PATCH_APPS}" ]; then
    # Modern carousel template (replaces old ImageFlow coverflow)
    if [ -f "${PATCH_APPS}/qubit/modules/digitalobject/templates/_imageflow.php" ]; then
        cp -f "${PATCH_APPS}/qubit/modules/digitalobject/templates/_imageflow.php" \
              "${ATOM_ROOT}/apps/qubit/modules/digitalobject/templates/_imageflow.php"
        echo "  ✓ Applied imageflow carousel patch (Slick/B5)"
    fi

    # Login security (brute-force lockout)
    if [ -f "${PATCH_APPS}/qubit/modules/user/actions/loginAction.class.php" ]; then
        cp -f "${PATCH_APPS}/qubit/modules/user/actions/loginAction.class.php" \
              "${ATOM_ROOT}/apps/qubit/modules/user/actions/loginAction.class.php"
        echo "  ✓ Applied login security patch (lockout)"
    fi

    # Password policy (reuse prevention + history)
    if [ -f "${PATCH_APPS}/qubit/modules/user/actions/passwordEditAction.class.php" ]; then
        cp -f "${PATCH_APPS}/qubit/modules/user/actions/passwordEditAction.class.php" \
              "${ATOM_ROOT}/apps/qubit/modules/user/actions/passwordEditAction.class.php"
        echo "  ✓ Applied password policy patch (reuse prevention)"
    fi

    # heratio#145 - Strongroom space allocation: physical-object show page
    # gets a "Strongroom" row that links to the assigned strongroom. Fails
    # soft when the ahg_strongroom tables are absent.
    if [ -f "${PATCH_APPS}/qubit/modules/physicalobject/templates/indexSuccess.php" ]; then
        cp -f "${PATCH_APPS}/qubit/modules/physicalobject/templates/indexSuccess.php" \
              "${ATOM_ROOT}/apps/qubit/modules/physicalobject/templates/indexSuccess.php"
        echo "  ✓ Applied physicalobject show patch (strongroom row, #145)"
    fi

    # heratio#145 - Strongroom space allocation: physical-object edit page
    # gets a read-only Strongroom block + Manage link to /strongroom/<slug>.
    if [ -f "${PATCH_APPS}/qubit/modules/physicalobject/templates/editSuccess.php" ]; then
        cp -f "${PATCH_APPS}/qubit/modules/physicalobject/templates/editSuccess.php" \
              "${ATOM_ROOT}/apps/qubit/modules/physicalobject/templates/editSuccess.php"
        echo "  ✓ Applied physicalobject edit patch (strongroom block, #145)"
    fi
else
    echo "  ⚠ No app patches found"
fi

# heratio#145 - Strongroom space allocation: holdings-report CSV gains
# 'physicalObjectStrongroom' + 'physicalObjectStrongroomSizeUsed' columns.
# Lives outside ${PATCH_APPS} because it's lib/, not apps/.
PATCH_LIB="${FRAMEWORK_PATH}/patches/lib"
if [ -f "${PATCH_LIB}/QubitPhysicalObjectCsvHoldingsReport.class.php" ]; then
    cp -f "${PATCH_LIB}/QubitPhysicalObjectCsvHoldingsReport.class.php" \
          "${ATOM_ROOT}/lib/QubitPhysicalObjectCsvHoldingsReport.class.php"
    echo "  ✓ Applied holdings report patch (Strongroom CSV columns, #145)"
fi

# ahgLdapUser — opt-in safe-by-default LDAP user class (#29).
# Enables `user.class: ahgLdapUser` in factories.yml; behaves as myUser until
# LDAP is turned on in Admin > AHG Settings > LDAP authentication.
if [ -f "${PATCH_LIB}/ahgLdapUser.class.php" ]; then
    cp -f "${PATCH_LIB}/ahgLdapUser.class.php" \
          "${ATOM_ROOT}/lib/ahgLdapUser.class.php"
    echo "  ✓ Applied ahgLdapUser patch (opt-in LDAP user class, #29)"
fi

# South African language UI catalogues.
#
# Upstream AtoM ships these with every <target> blank (they are not Artefactual
# translations), so an upgrade silently replaces local translation work with an
# empty stub — exactly what happened to Afrikaans on PSIS at 2.10. Nothing warns
# you, because an empty target legitimately falls back to English. This work will
# never come back from upstream, so it must be reapplied on every install.
#
# Any language directory added under patches/apps/qubit/i18n/ is picked up here;
# no need to edit this block when a new one is contributed.
if [ -d "${PATCH_APPS}/qubit/i18n" ]; then
    i18n_applied=0
    for lang_dir in "${PATCH_APPS}"/qubit/i18n/*/; do
        [ -d "${lang_dir}" ] || continue
        lang_code="$(basename "${lang_dir}")"
        [ -f "${lang_dir}messages.xml" ] || continue

        mkdir -p "${ATOM_ROOT}/apps/qubit/i18n/${lang_code}"
        cp -f "${lang_dir}messages.xml" \
              "${ATOM_ROOT}/apps/qubit/i18n/${lang_code}/messages.xml"

        # Count non-empty <target> elements so the operator sees real coverage
        # rather than a bare "applied". grep -c prints 0 AND exits 1 when there
        # are no matches, so the fallback must be an assignment, not an echo.
        translated="$(grep -c '<target[^/>]*>[^<]' "${lang_dir}messages.xml" 2>/dev/null)" || translated=0
        echo "  ✓ Applied ${lang_code} i18n catalogue (${translated} translated)"
        i18n_applied=$((i18n_applied + 1))
    done
    if [ "${i18n_applied}" -gt 0 ]; then
        echo "  ✓ ${i18n_applied} language catalogue(s) applied"
    fi
fi

# AtoM 2.10.1 security fixes (coordinated disclosure to Artefactual, 2026-07-12).
# ATOM-1..9: XXE in XML import, REST physical-object create ACL, finding-aid
# generate/delete authorization, digitalobject update CSRF, CSV export draft
# leak, unserialize allowed_classes hardening, weak password salt, pdftotext
# argument escaping. Each source mirrors its AtoM base path under patches/,
# with the leading "plugins/" segment dropped (as with the qbAclPlugin patch).
SECFIX_FILES=(
    "lib/QubitXmlImport.class.php"
    "lib/QubitFindingAid.class.php"
    "lib/QubitCsvTransform.class.php"
    "lib/model/QubitInformationObject.php"
    "lib/model/QubitActor.php"
    "lib/model/QubitUser.php"
    "lib/filter/QubitSettingsFilter.class.php"
    "apps/qubit/modules/informationobject/actions/generateFindingAidAction.class.php"
    "apps/qubit/modules/informationobject/actions/deleteFindingAidAction.class.php"
    "apps/qubit/modules/informationobject/actions/exportCsvAction.class.php"
    "apps/qubit/modules/digitalobject/actions/updateAction.class.php"
    "apps/qubit/modules/settings/actions/inventoryAction.class.php"
    "plugins/arRestApiPlugin/modules/api/actions/physicalobjectsCreateAction.class.php"
    # ATOM-10 (AHG 2026-08-24, reported by a cataloguer): SKOS import fatals on a
    # null atom:id when a skos:related names a concept the importer never
    # imported - which a file declaring a ConceptScheme makes easy to hit. Kills
    # the run after terms are already saved, so a retry duplicates them.
    # Unchanged in 2.10.2; filed upstream as artefactual/atom issue 2418.
    # (Deliberately no quoted phrases in these comments: anything parsing this
    # array by grepping quoted strings picks them up as phantom entries.)
    "plugins/sfSkosPlugin/lib/sfSkosPlugin.class.php"
    # ATOM-11 (AHG 2026-08-25): PHP 8 turns a string-offset read into a TypeError,
    # which base AtoM guards against as sfException only - so an unauthenticated
    # POST to any unroutable path escapes uncaught. Those arrive with no status
    # code and so take the alert-email path, letting a remote scanner drive the
    # error mail. 31 in 2.5 minutes on PSIS from a single scanner.
    "lib/routing/QubitRoute.class.php"
    # Artefactual official advisory (gist b7875f8): autocomplete access control -
    # unauthenticated user/actor/taxonomy/search autocomplete leaked user metadata
    # (usernames/emails/roles) + draft description titles. Route-level security.yml.
    "apps/qubit/config/security.yml"
    "apps/qubit/modules/actor/config/security.yml"
    "apps/qubit/modules/search/config/security.yml"
    "apps/qubit/modules/taxonomy/config/security.yml"
    "apps/qubit/modules/user/config/security.yml"
)
SECFIX_APPLIED=0
for _rel in "${SECFIX_FILES[@]}"; do
    _src="${FRAMEWORK_PATH}/patches/${_rel#plugins/}"
    if [ -f "${_src}" ]; then
        mkdir -p "$(dirname "${ATOM_ROOT}/${_rel}")"
        cp -f "${_src}" "${ATOM_ROOT}/${_rel}"
        SECFIX_APPLIED=$((SECFIX_APPLIED + 1))
    fi
done
echo "  ✓ Applied AtoM 2.10.1 security fixes (${SECFIX_APPLIED}/20 files, ATOM-1..11 + autocomplete advisory)"

fi   # end of APPLY_BASE_PATCHES

# =============================================================================
# Step 12: Copy dist assets (icons)
# =============================================================================
echo ""
echo "Step 12: Copying dist assets..."

mkdir -p "${ATOM_ROOT}/dist/icons"

if [ -d "${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist/icons" ]; then
    cp -r "${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist/icons/"* "${ATOM_ROOT}/dist/icons/" 2>/dev/null
    echo "  ✓ Copied $(ls ${AHG_PLUGINS}/ahgThemeB5Plugin/web/dist/icons/ | wc -l) icons to dist/icons/"
else
    echo "  ⚠ No icons found in ahgThemeB5Plugin/web/dist/icons/"
fi

# =============================================================================
# Step 13: Give culture-invariant settings a row per enabled UI language
# =============================================================================
# AtoM stores siteBaseUrl in setting_i18n and reads it back for the CURRENT
# culture with no fallback to source_culture. The settings form only ever writes
# the culture the admin happened to be using, so a base URL set in English reads
# as empty in every other language and apps/qubit/templates/_header.php nags
# administrators to "set your site base URL" — one that is already set. Insert
# only; a value someone has corrected is never overwritten.
echo ""
echo "Step 13: Syncing culture-invariant settings across enabled languages..."

if [ -f "${FRAMEWORK_PATH}/bin/atom" ]; then
    (cd "${FRAMEWORK_PATH}" && php bin/atom tools:settings --sync-cultures) \
        || echo "  ⚠ Culture sync skipped (non-fatal)"
else
    echo "  ⚠ bin/atom not found, skipped"
fi

