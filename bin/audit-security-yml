#!/usr/bin/env bash
# =============================================================================
# AtoM Heratio - module security.yml audit
#
# A module without modules/<name>/config/security.yml inherits
# apps/qubit/config/security.yml, where `default: is_secure: false` makes every
# action PUBLIC. The absence of a file is therefore the bug - and it is invisible
# in review, because nothing looks wrong when nothing is there.
#
# That is not theoretical. On 2026-08-03 this pattern was found exposing, all
# anonymously: heritage accounting (settings/add/edit plus a POST write path),
# scanManage (create and run, feeding a worker that MOVES files), copyCataloguing
# (created information objects from posted MARC), the heritage API (full asset
# financial records and authority enumeration), and physical storage browse and
# holdings export.
#
# Reports every module that has actions but declares no security posture.
# See bin/audit-security-yml-check for the CI ratchet.
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FRAMEWORK_DIR="$(dirname "$SCRIPT_DIR")"

# Overridable so CI can point at checkouts that are not siblings on disk.
ATOM_ROOT="${ATOM_ROOT:-$(dirname "$FRAMEWORK_DIR")}"
APPS_DIR="${APPS_DIR:-$ATOM_ROOT/apps/qubit/modules}"
PLUGINS_DIR="${PLUGINS_DIR:-$ATOM_ROOT/atom-ahg-plugins}"

FORMAT="${1:-text}"   # text | list | scopes

declare -a MISSING=()
declare -a SCOPES=()

GUARD_RE="isAdministrator|isAuthenticated|forward\('admin', *'secure'\)|AclService::|hasGroup|checkAdminAccess|requireAuth"

# A preExecute counts as covering its whole class only if it actually REFUSES.
# Mentioning isAuthenticated is not refusing - that is the same mistake the
# parent-class note below warns about.
# Parenthesis-free on purpose: this string is passed through `awk -v`, which
# runs its own escape processing, so a literal \( needs escaping twice and got
# eaten - awk then died with "invalid regexp" on every class with a preExecute
# and the caller swallowed it. Silence, from the audit whose whole point is not
# being silent. Match on the distinctive words instead.
REFUSE_RE="forward403|forward404|'secure'|setStatusCode|throw new"



scan_module() {
    local dir="$1" label="$2"
    [ -d "$dir/actions" ] || return 0

    # A security.yml covers every action in the module, including ones added
    # later. Nothing more to check.
    [ -f "$dir/config/security.yml" ] && return 0

    # Per ACTION, not per module.
    #
    # This used to grep every action file at once and pass the module if ANY of
    # them mentioned a guard. That is the wrong shape: a module where most
    # actions check themselves and one does not looks identical to a module where
    # all of them do. It missed two real holes on 2026-08-17 -
    # ahgConditionPlugin's `template` action, served to anyone, and
    # ahgRequestToPublishPlugin's `submit` and `receipt` in the camelCase module -
    # because their neighbours were guarded.
    #
    # Report the unguarded actions individually so the gap is visible and can be
    # closed one file at a time.
    local f base parent unguarded=()
    for f in "$dir"/actions/*.php; do
        [ -f "$f" ] || continue
        base="$(basename "$f")"

        # Components and helpers are not routable entry points.
        case "$base" in
            components.class.php|*Component.class.php|*Form.class.php) continue ;;
        esac

        # One guard anywhere in the file used to exempt the whole file, which is
        # the per-module bug again one level down. A multi-action
        # actions.class.php is not one action: ahgExhibitionPlugin's exhibition
        # module holds 32 of them, and a single `isAuthenticated` in a preExecute
        # that only covers writes meant all 32 passed. /index.php/exhibition
        # served its management screen, New Exhibition button and statistics to
        # anonymous visitors while this audit reported nothing, and the module was
        # never once in the baseline. Found on 2026-09-28 by opening the page, not
        # by reading the audit.
        #
        # So: a file defining several execute* methods is split and each one
        # judged on its own body.
        if [ "$(grep -cE 'function[ \t]+&?execute[A-Za-z0-9_]*[ \t]*\(' "$f" 2>/dev/null || true)" -le 1 ]; then
            grep -qE "$GUARD_RE" "$f" 2>/dev/null && continue
            MULTI=""
        else
            MULTI="yes"
        fi

        # A guard inherited from the base class counts.
        #
        # Without this the audit is worse than useless on APIs: ahgAPIPlugin's 62
        # apiv2 actions all extend AhgApiController, which checks an API key and
        # answers 401/403 in preExecute. Reporting them as unguarded buries the
        # handful of real gaps in false positives, and an audit nobody trusts
        # gets ignored.
        parent="$(grep -oE 'extends[[:space:]]+[A-Za-z_\\]+' "$f" 2>/dev/null | head -1 | awk '{print $2}')"
        if [ -n "$parent" ]; then
            parent="${parent##*\\}"

            # Search base AtoM too, not only our own code.
            #
            # Most add/edit/delete actions in the sector plugins are thin stubs
            # over base AtoM's - museumDeleteAction is 28 lines extending
            # InformationObjectDeleteAction, which carries the ACL check. Looking
            # only in atom-ahg-plugins reports every one of them as unguarded,
            # which is how this audit produced a delete action that looked
            # anonymously reachable and was not.
            # A CURATED list, not a grep of the parent's source.
            #
            # Searching the parent file for guard keywords was tried and is
            # useless in both directions: nearly every action extends
            # AhgController or sfAction, whose sources mention isAuthenticated
            # somewhere, so everything passed and the audit reported ZERO
            # unguarded actions. A silent audit is worse than a noisy one.
            #
            # Only classes verified to ENFORCE - not merely mention - belong here.
            # Add to it when you have checked the parent actually refuses.
            case "$parent" in
                AhgApiController|AhgApiAction)
                    # preExecute checks an API key and answers 401/403.
                    continue ;;
                InformationObjectDeleteAction|InformationObjectEditAction)
                    # Base AtoM's own actions, which carry the ACL check. The
                    # sector plugins subclass them as thin stubs.
                    continue ;;
            esac
        fi

        if [ -z "$MULTI" ]; then
            unguarded+=("$base")

            continue
        fi

        # Per execute* method. A preExecute excuses the whole class only when it
        # refuses UNCONDITIONALLY. ahgExhibitionPlugin's refuses for a hardcoded
        # list of write actions and lets every read through, so treating it as
        # covering the class is precisely the hole this is fixing. Where a
        # preExecute conditions on the action name we cannot tell which actions it
        # covers, so we report them all and let a security.yml settle it - noisy
        # in the direction that gets looked at.
        local acts
        acts="$(awk -v guard="$GUARD_RE" -v refuse="$REFUSE_RE" '
            function flush(   g) {
                if (cur == "") return
                g = (buf ~ guard) ? "guarded" : "open"
                if (cur == "preExecute") {
                    if (buf ~ refuse && buf !~ /getActionName|\$writeActions/) print "COVERS_ALL"
                } else if (cur ~ /^execute/ && g == "open") {
                    print cur
                }
                cur = ""; buf = ""
            }
            {
                if (match($0, /function[ \t]+&?[A-Za-z_][A-Za-z0-9_]*[ \t]*\(/)) {
                    flush()
                    name = substr($0, RSTART, RLENGTH)
                    sub(/^function[ \t]+&?/, "", name); sub(/[ \t]*\($/, "", name)
                    cur = name
                }
                buf = buf "\n" $0
            }
            END { flush() }
        ' "$f" 2>/dev/null)" || acts="AWK_FAILED"

        # Fail closed. If the split could not be done, the file is reported
        # whole rather than skipped - an audit that goes quiet when it cannot
        # parse something is worse than one that over-reports.
        case "$acts" in
            *AWK_FAILED*) unguarded+=("$base"); continue ;;
            *COVERS_ALL*) continue ;;
        esac

        local act
        for act in $acts; do
            unguarded+=("$base::$act")
        done
    done

    [ ${#unguarded[@]} -eq 0 ] && return 0

    local a
    for a in "${unguarded[@]}"; do
        MISSING+=("$label/$a")
    done
}

# Base application modules
if [ -d "$APPS_DIR" ]; then
    SCOPES+=("apps")
    for d in "$APPS_DIR"/*/; do
        [ -d "$d" ] || continue
        scan_module "$d" "apps/qubit/modules/$(basename "$d")"
    done
fi

# AHG plugin modules
if [ -d "$PLUGINS_DIR" ]; then
    SCOPES+=("plugins")
    for d in "$PLUGINS_DIR"/*/modules/*/; do
        [ -d "$d" ] || continue
        plugin="$(basename "$(dirname "$(dirname "$d")")")"
        scan_module "$d" "$plugin/$(basename "$d")"
    done
fi

# Which scopes were actually present. A caller that cannot tell the difference
# between "nothing is wrong" and "nothing was looked at" will eventually report
# the second as the first.
if [ "$FORMAT" = "scopes" ]; then
    printf '%s\n' "${SCOPES[@]+"${SCOPES[@]}"}"
    exit 0
fi

if [ "$FORMAT" = "list" ]; then
    printf '%s\n' "${MISSING[@]+"${MISSING[@]}"}" | sort
    exit 0
fi

if [ ${#SCOPES[@]} -eq 0 ]; then
    echo "Nothing scanned: neither $APPS_DIR nor $PLUGINS_DIR exists."
    echo "Set ATOM_ROOT, APPS_DIR or PLUGINS_DIR to point at the checkouts."
    exit 2
fi

echo "Modules with actions but no security.yml and no code-level guard:"
echo
printf '  %s\n' "${MISSING[@]+"${MISSING[@]}"}" | sort
echo
echo "Total: ${#MISSING[@]}"
echo
echo "Each inherits 'default: is_secure: false' and is therefore PUBLIC."
echo "Add modules/<name>/config/security.yml declaring the posture explicitly -"
echo "including 'all: { is_secure: false }' where a module is genuinely public."
echo
echo "NOTE: a plugin module overriding a base module's routes under a DIFFERENT"
echo "name does NOT inherit the base module's security.yml. storageManage"
echo "(/physicalobject/*) and rightsHolderManage (/rightsholder/*) both silently"
echo "dropped base AtoM's access control that way."
