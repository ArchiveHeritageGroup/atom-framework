#!/usr/bin/env bash
#
# Generate ahgRuntimePlugin from atom-framework.
#
# Why generate rather than fork: the framework has to keep working as a directory for
# Heratio and PSIS, while community installs want it shaped like an ordinary plugin so
# it installs through the stock plugin admin UI. Generating one from the other keeps a
# single source of truth - editing the framework is the only way to change the runtime.
#
# Usage: bin/build-runtime-plugin [output-dir]
#        default output: ../atom-ahg-plugins/ahgRuntimePlugin

set -euo pipefail

FRAMEWORK="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-$(cd "$FRAMEWORK/.." && pwd)/atom-ahg-plugins/ahgRuntimePlugin}"
# version.json is the framework's version of record (bin/release maintains it).
VERSION="$(python3 -c "import json;print(json.load(open('$FRAMEWORK/version.json'))['version'])" 2>/dev/null || echo '0.0.0')"

echo "Building ahgRuntimePlugin"
echo "  from : $FRAMEWORK"
echo "  to   : $OUT"
echo "  ver  : $VERSION"

# Never delete a target that is not ours - a mistyped argument must not eat a directory.
# An EMPTY directory is not someone's work - it is what an interrupted rebuild
# leaves behind, and refusing it strands the build permanently. Only a target
# with contents and no marker is treated as foreign.
if [ -e "$OUT" ] && [ ! -f "$OUT/.generated-by-build-runtime-plugin" ]; then
    if [ -d "$OUT" ] && [ -z "$(ls -A "$OUT" 2>/dev/null)" ]; then
        echo "  note : target exists but is empty (interrupted build?) - proceeding"
    else
        echo "REFUSING: $OUT exists and was not generated by this script." >&2
        echo "Remove it deliberately if you mean to replace it." >&2
        exit 1
    fi
fi

rm -rf "$OUT"
mkdir -p "$OUT"/{config,database,lib}
touch "$OUT/.generated-by-build-runtime-plugin"   # provenance is written at the end, once the copy is countable

# ---------------------------------------------------------------- code + deps
cp -r "$FRAMEWORK/src"    "$OUT/src"
cp -r "$FRAMEWORK/vendor" "$OUT/vendor"

# Operator scripts - the backup and restore shell scripts that ahgBackupPlugin
# tells administrators to schedule. They were never copied, so the cron line the
# settings page prints pointed at a file the bundle did not contain.
if [ -d "$FRAMEWORK/scripts" ]; then
    cp -r "$FRAMEWORK/scripts" "$OUT/scripts"
    chmod +x "$OUT/scripts/"*.sh 2>/dev/null || true
fi
[ -f "$FRAMEWORK/bootstrap.php" ] && cp "$FRAMEWORK/bootstrap.php" "$OUT/bootstrap.php"

# The CLI entry point for plugin tasks.
#
# symfony builds its task list from ProjectConfiguration's plugin list, and on a
# packaged install that is stock AtoM - the base ten and nothing else. The AHG
# plugins are enabled from the database by sfPluginAdminPlugin, which only runs
# for a web request. So every plugin worked in the browser and none of their
# tasks existed at the command line: ten preservation tasks shipped in the bundle
# and `php symfony preservation:fixity` answered "no tasks defined in the
# preservation namespace". Fixity and virus scanning are scheduled jobs by
# nature, so that is most of the point of the plugin.
#
# bin/ahg reads the same setting the web request does and enables those plugins
# before symfony builds its task list. Base AtoM is untouched; this sits beside
# `symfony` rather than replacing it.
if [ -f "$FRAMEWORK/bin/ahg-cli.php" ]; then
    mkdir -p "$OUT/bin"
    cp "$FRAMEWORK/bin/ahg-cli.php" "$OUT/bin/ahg"
    chmod +x "$OUT/bin/ahg"
fi

# patches-verify: reports whether base AtoM patches are still applied.
#
# An operator tool, so it has to reach the operator. It was written into the
# framework and not copied here, which meant it existed for us and for nobody
# running a packaged install - the people most likely to upgrade AtoM underneath
# it and silently lose the security fixes those patches carry.
if [ -f "$FRAMEWORK/bin/patches-verify" ]; then
    mkdir -p "$OUT/bin"
    cp "$FRAMEWORK/bin/patches-verify" "$OUT/bin/patches-verify"
    chmod +x "$OUT/bin/patches-verify"
fi

# ---------------------------------------------------------------- schema
# ONLY the runtime's own tables. The framework's install.sql creates all 273 tables in
# the estate regardless of which plugins are installed (issue #269); carrying that into
# the plugin would defeat the per-plugin schema model, where each plugin ships its own
# database/install.sql.
{
    echo "-- ahgRuntimePlugin schema - runtime tables ONLY."
    echo "-- Every other table belongs to the plugin that uses it."
    echo
    cat "$FRAMEWORK/database/runtime_tables.sql"
    echo
    cat "$FRAMEWORK/database/encryption_tables.sql"
} > "$OUT/database/install.sql"

# ---------------------------------------------------------------- plugin shape
cat > "$OUT/config/ahgRuntimePluginConfiguration.class.php" <<PHP
<?php

/**
 * AHG runtime - the shared classes and services every AHG plugin builds on.
 *
 * GENERATED from atom-framework by bin/build-runtime-plugin. Do not edit here; edit
 * the framework and regenerate, or the two copies drift.
 *
 * Installing this is what makes every other AHG plugin work: 112 of 115 of them use
 * something from it, and 99 extend AhgController directly.
 */
class ahgRuntimePluginConfiguration extends sfPluginConfiguration
{
    public static \$summary = 'AHG runtime - shared services and base classes required by AHG plugins';
    public static \$version = '$VERSION';

    public function initialize()
    {
        \$bootstrap = __DIR__.'/../bootstrap.php';

        if (file_exists(\$bootstrap)) {
            require_once \$bootstrap;
        }
    }
}
PHP

# Tables the generated install.sql actually creates.
#
# The manifest used to omit "tables" entirely, so install-plugin-schema.php had
# nothing to verify against and reported success without checking anything - the
# same stale-manifest problem that hid a missing table in every other plugin
# until 2026-08-18. Derive it from the SQL so it cannot drift.
#
# Backticks are optional in the SQL and comments are stripped first, because a
# line reading "-- CREATE TABLE IF NOT EXISTS, safe to re-run" otherwise matches.
RUNTIME_TABLES=$(sed -e 's/--.*$//' "$OUT/database/install.sql" 2>/dev/null \
  | grep -oiE 'CREATE[[:space:]]+TABLE([[:space:]]+IF[[:space:]]+NOT[[:space:]]+EXISTS)?[[:space:]]+`?[a-z0-9_]+`?[[:space:]]*\(' \
  | sed -E 's/.*[[:space:]]`?([a-z0-9_]+)`?[[:space:]]*\(/\1/' \
  | sort -u \
  | awk 'BEGIN{ORS=""} {printf "%s\"%s\"", (NR>1 ? ", " : ""), $0}')

cat > "$OUT/extension.json" <<JSON
{
  "name": "ahgRuntimePlugin",
  "version": "$VERSION",
  "description": "AHG runtime - shared services and base classes required by AHG plugins",
  "tier": "community",
  "license": "AGPL-3.0-or-later",
  "dependencies": [],
  "generated_from": "atom-framework",
  "tables": [$RUNTIME_TABLES],
  "display_panels": []
}
JSON

cat > "$OUT/README.md" <<'MD'
# ahgRuntimePlugin

Generated from `atom-framework` by `bin/build-runtime-plugin`. **Do not edit in place** -
edit the framework and regenerate.

Install this before any other AHG plugin. It provides `AhgController` (99 plugins extend
it), `AhgComponents`, the services, the routing loader, and a bundled Illuminate.

Its `install.sql` creates only the runtime's own tables. Every other plugin ships its
own schema.
MD

echo
echo "Built: $(du -sh "$OUT" | cut -f1)"
PHP_FILES="$(find "$OUT/src" -name '*.php' 2>/dev/null | wc -l)"

# Provenance. The marker used to be an empty touch file, so the only way to ask
# "is this copy current?" was to compare mtimes - which a plain `cp -r` makes
# meaningless and any `touch` makes wrong. Recording what this copy was built
# FROM turns a guess into a comparison. See issue #301.
# -c safe.directory: the checkout is often owned by a different user than the
# one running the build (www-data), and git then refuses to read it - which
# silently stamped the commit as "unknown".
FRAMEWORK_COMMIT="$(git -C "$FRAMEWORK" -c safe.directory="$FRAMEWORK" rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
cat > "$OUT/.generated-by-build-runtime-plugin" <<STAMP
{
  "generated_at": "$(date -u '+%Y-%m-%dT%H:%M:%SZ')",
  "framework_version": "$VERSION",
  "framework_commit": "$FRAMEWORK_COMMIT",
  "framework_path": "$FRAMEWORK",
  "php_files": $PHP_FILES
}
STAMP

echo "  php files : $PHP_FILES"
echo "  stamped   : $VERSION ($FRAMEWORK_COMMIT)"
echo "  tables    : $(grep -ciE '^\s*CREATE TABLE' "$OUT/database/install.sql")"
