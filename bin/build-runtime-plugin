#!/usr/bin/env bash
#
# Generate ahgRuntimePlugin from atom-framework.
#
# Why generate rather than fork: the framework has to keep working as a directory for
# Heratio and PSIS, while community installs want it shaped like an ordinary plugin so
# it installs through the stock plugin admin UI. Generating one from the other keeps a
# single source of truth - editing the framework is the only way to change the runtime.
#
# Usage: bin/build-runtime-plugin [output-dir]
#        default output: ../atom-ahg-plugins/ahgRuntimePlugin

set -euo pipefail

FRAMEWORK="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="${1:-$(cd "$FRAMEWORK/.." && pwd)/atom-ahg-plugins/ahgRuntimePlugin}"
# version.json is the framework's version of record (bin/release maintains it).
VERSION="$(python3 -c "import json;print(json.load(open('$FRAMEWORK/version.json'))['version'])" 2>/dev/null || echo '0.0.0')"

echo "Building ahgRuntimePlugin"
echo "  from : $FRAMEWORK"
echo "  to   : $OUT"
echo "  ver  : $VERSION"

# Never delete a target that is not ours - a mistyped argument must not eat a directory.
if [ -e "$OUT" ] && [ ! -f "$OUT/.generated-by-build-runtime-plugin" ]; then
    echo "REFUSING: $OUT exists and was not generated by this script." >&2
    echo "Remove it deliberately if you mean to replace it." >&2
    exit 1
fi

rm -rf "$OUT"
mkdir -p "$OUT"/{config,database,lib}
touch "$OUT/.generated-by-build-runtime-plugin"

# ---------------------------------------------------------------- code + deps
cp -r "$FRAMEWORK/src"    "$OUT/src"
cp -r "$FRAMEWORK/vendor" "$OUT/vendor"

# Operator scripts - the backup and restore shell scripts that ahgBackupPlugin
# tells administrators to schedule. They were never copied, so the cron line the
# settings page prints pointed at a file the bundle did not contain.
if [ -d "$FRAMEWORK/scripts" ]; then
    cp -r "$FRAMEWORK/scripts" "$OUT/scripts"
    chmod +x "$OUT/scripts/"*.sh 2>/dev/null || true
fi
[ -f "$FRAMEWORK/bootstrap.php" ] && cp "$FRAMEWORK/bootstrap.php" "$OUT/bootstrap.php"

# ---------------------------------------------------------------- schema
# ONLY the runtime's own tables. The framework's install.sql creates all 273 tables in
# the estate regardless of which plugins are installed (issue #269); carrying that into
# the plugin would defeat the per-plugin schema model, where each plugin ships its own
# database/install.sql.
{
    echo "-- ahgRuntimePlugin schema - runtime tables ONLY."
    echo "-- Every other table belongs to the plugin that uses it."
    echo
    cat "$FRAMEWORK/database/runtime_tables.sql"
    echo
    cat "$FRAMEWORK/database/encryption_tables.sql"
} > "$OUT/database/install.sql"

# ---------------------------------------------------------------- plugin shape
cat > "$OUT/config/ahgRuntimePluginConfiguration.class.php" <<PHP
<?php

/**
 * AHG runtime - the shared classes and services every AHG plugin builds on.
 *
 * GENERATED from atom-framework by bin/build-runtime-plugin. Do not edit here; edit
 * the framework and regenerate, or the two copies drift.
 *
 * Installing this is what makes every other AHG plugin work: 112 of 115 of them use
 * something from it, and 99 extend AhgController directly.
 */
class ahgRuntimePluginConfiguration extends sfPluginConfiguration
{
    public static \$summary = 'AHG runtime - shared services and base classes required by AHG plugins';
    public static \$version = '$VERSION';

    public function initialize()
    {
        \$bootstrap = __DIR__.'/../bootstrap.php';

        if (file_exists(\$bootstrap)) {
            require_once \$bootstrap;
        }
    }
}
PHP

cat > "$OUT/extension.json" <<JSON
{
  "name": "ahgRuntimePlugin",
  "version": "$VERSION",
  "description": "AHG runtime - shared services and base classes required by AHG plugins",
  "tier": "community",
  "license": "AGPL-3.0-or-later",
  "dependencies": [],
  "generated_from": "atom-framework",
  "display_panels": []
}
JSON

cat > "$OUT/README.md" <<'MD'
# ahgRuntimePlugin

Generated from `atom-framework` by `bin/build-runtime-plugin`. **Do not edit in place** -
edit the framework and regenerate.

Install this before any other AHG plugin. It provides `AhgController` (99 plugins extend
it), `AhgComponents`, the services, the routing loader, and a bundled Illuminate.

Its `install.sql` creates only the runtime's own tables. Every other plugin ships its
own schema.
MD

echo
echo "Built: $(du -sh "$OUT" | cut -f1)"
echo "  php files : $(find "$OUT/src" -name '*.php' 2>/dev/null | wc -l)"
echo "  tables    : $(grep -ciE '^\s*CREATE TABLE' "$OUT/database/install.sql")"
