#!/usr/bin/env bash
#
# Build a distributable zip for one AHG plugin.
#
# Why this exists: Provenance and Backup were assembled by hand, and the second
# INSTALL.md was a sed of the first. That does not survive a dozen plugins - the
# version, the table list and the dependencies drift from what the plugin
# actually declares, and the person reading the instructions is the one who finds
# out. Everything here is read from extension.json so there is one source of
# truth.
#
# The runtime is NOT bundled. It is 56MB unpacked and identical for every plugin,
# so twelve bundles would carry twelve copies and a runtime fix would mean twelve
# re-releases. It ships once, as its own download, and INSTALL.md names the
# version required.
#
# Usage: bin/build-plugin-bundle <pluginName> [output-dir]
#
set -euo pipefail

PLUGIN="${1:-}"
if [ -z "$PLUGIN" ]; then
    echo "Usage: $0 <pluginName> [output-dir]" >&2
    exit 1
fi

FRAMEWORK="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="$(cd "$FRAMEWORK/.." && pwd)"
PLUGINS="$ROOT/atom-ahg-plugins"
OUTDIR="${2:-$ROOT/stuff/dist}"
SRC="$PLUGINS/$PLUGIN"

[ -d "$SRC" ] || { echo "No such plugin: $SRC" >&2; exit 1; }
[ -f "$SRC/extension.json" ] || { echo "$PLUGIN has no extension.json" >&2; exit 1; }

meta() { python3 -c "import json,sys;d=json.load(open('$SRC/extension.json'));print(d.get('$1','') if not isinstance(d.get('$1'),list) else ' '.join(d.get('$1')))"; }

VERSION="$(meta version)"
NAME="$(meta name)"
DESC="$(meta description)"
LICENCE="$(meta license)"
# Dependencies, resolved transitively.
#
# This read only the plugin's own dependencies list, so a bundle carried its
# direct dependencies and nothing further. ahgSeadragonPlugin declares
# ahgIiifPlugin, which declares ahgCorePlugin, and the resulting zip contained the
# first and not the second - a plugin that cannot boot, packaged and shipped.
resolve_deps() {
    local plugin="$1" seen="$2" out="" dep
    for dep in $(python3 -c "import json,sys;d=json.load(open('$PLUGINS/$plugin/extension.json'));print(' '.join(d.get('dependencies',[])))" 2>/dev/null); do
        case " $seen " in *" $dep "*) continue ;; esac
        seen="$seen $dep"
        out="$out $dep $(resolve_deps "$dep" "$seen")"
        seen="$seen $out"
    done
    echo "$out"
}

DEPS="$(resolve_deps "$PLUGIN" "$PLUGIN" | tr ' ' '\n' | awk 'NF' | awk '!seen[$0]++' | tr '\n' ' ')"
RUNTIME_VERSION="$(python3 -c "import json;print(json.load(open('$FRAMEWORK/version.json'))['version'])" 2>/dev/null || echo '0.0.0')"

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$OUTDIR"

echo "Building $PLUGIN $VERSION"

# ------------------------------------------------------------------ payload
cp -r "$SRC" "$STAGE/$PLUGIN"
rm -rf "$STAGE/$PLUGIN/.git" "$STAGE/$PLUGIN/node_modules"
find "$STAGE/$PLUGIN" -name '*.log' -delete 2>/dev/null || true

# ahgCorePlugin is the foundation every AHG plugin builds on, so it travels with
# each bundle. It is small; the runtime is the large part and that ships apart.
for dep in $DEPS; do
    if [ -d "$PLUGINS/$dep" ]; then
        cp -r "$PLUGINS/$dep" "$STAGE/$dep"
        rm -rf "$STAGE/$dep/.git" "$STAGE/$dep/node_modules"
    else
        echo "  WARNING: declared dependency $dep is not present" >&2
    fi
done

[ -f "$PLUGINS/LICENSE" ] && cp "$PLUGINS/LICENSE" "$STAGE/LICENSE"

# Screenshots, if any have been captured for this plugin.
if [ -d "$ROOT/stuff/screenshots/$PLUGIN" ]; then
    cp -r "$ROOT/stuff/screenshots/$PLUGIN" "$STAGE/screenshots"
fi

# ------------------------------------------------------------------ schema summary
TABLES=""
if [ -f "$SRC/database/install.sql" ]; then
    # Tolerates an install.sql that creates no tables - several plugins ship one
    # that only seeds data. grep returns 1 on no match, and under pipefail that
    # aborted the build for fifteen plugins with no message at all.
    TABLES="$( { grep -ohiE 'CREATE TABLE (IF NOT EXISTS )?`?[a-z_]+`?' "$SRC/database/install.sql" 2>/dev/null || true; } \
        | { grep -oiE '[a-z_]+`?$' || true; } | tr -d '`' | sort -u | sed 's/^/    /')"
fi

# Enable order: dependencies deepest first.
#
# resolve_deps discovers direct dependencies before transitive ones, so its output
# is in the reverse of the order they must be enabled. Printed as discovered, the
# instructions told a Seadragon installer to enable ahgIiifPlugin before
# ahgCorePlugin, which is precisely backwards - IIIF depends on core.
INSTALL_ORDER="ahgRuntimePlugin"
for dep in $(echo "$DEPS" | tr ' ' '\n' | awk 'NF' | tac); do
    INSTALL_ORDER="$INSTALL_ORDER $dep"
done
INSTALL_ORDER="$INSTALL_ORDER $PLUGIN"

# ------------------------------------------------------------------ instructions
{
cat <<EOF
# $NAME - installation

$DESC

## Requirements

    AtoM            2.9 or 2.10
    PHP             8.1 or later
    MySQL           8.0
    ahgRuntimePlugin $RUNTIME_VERSION or later, installed separately

AtoM 2.9 and 2.10 both require PHP 8 already, so on a supported AtoM there is
nothing to prepare. AtoM 2.8 is not supported: it is the last release that runs on
PHP 7.4, and the runtime is built on Laravel 10, which is PHP 8.1+ by
construction.

Nothing in base AtoM is modified. No file under apps/, lib/, vendor/ or config/ is
touched, and ProjectConfiguration.class.php stays as upstream ships it.

## Install

Install ahgRuntimePlugin first if it is not already present - it is a separate
download, shared by every AHG plugin.

From the AtoM root:

    unzip $PLUGIN-$VERSION.zip -d plugins/
    chown -R www-data:www-data plugins/

Load the schema. Each plugin owns its own tables:

EOF
for p in $DEPS $PLUGIN; do
    [ -f "$PLUGINS/$p/database/install.sql" ] && echo "    mysql -u <user> -p <database> < plugins/$p/database/install.sql"
done
cat <<EOF

Enable in this order, in Admin > Plugins:

EOF
i=1
for p in $INSTALL_ORDER; do echo "    $i. $p"; i=$((i+1)); done
cat <<EOF

Then clear the cache and reload PHP:

    rm -rf cache/*
    php symfony cc
    systemctl reload php8.3-fpm

## Tables created

$( [ -n "$TABLES" ] && echo "$TABLES" || echo "    (none)" )

## If a page fails

Read the AtoM log rather than the rendered page. AtoM returns HTTP 200 for pages
that are not successes - the login page among them - so a status code on its own
proves very little, and an empty body with a 200 usually means a fatal:

    tail -50 log/qubit_prod.log

## If the AtoM root lives under /usr/share/nginx

php-fpm ships with ProtectSystem=full, which mounts /usr read-only for the worker.
The site then cannot write its own cache or logs and every page returns 500 with an
empty body - a symptom that looks nothing like a permissions problem. Grant the
paths in /etc/systemd/system/php8.3-fpm.service.d/<site>-storage.conf:

    [Service]
    ReadWritePaths=/usr/share/nginx/<site>/log
    ReadWritePaths=/usr/share/nginx/<site>/cache
    ReadWritePaths=/usr/share/nginx/<site>/uploads
    ReadWritePaths=/usr/share/nginx/<site>/downloads
    ReadWritePaths=/usr/share/nginx/<site>/backups

Then systemctl daemon-reload && systemctl restart php8.3-fpm.

$( [ -d "$SRC/config/cantaloupe" ] && cat <<'CANTALOUPE'
## The IIIF image server

Deep zoom and image tiling need an IIIF image server. Cantaloupe is the usual
choice. Manifests, the viewer and OCR export work without one; tiled images do not.

### 1. Install Cantaloupe

Download a release from https://cantaloupe-project.github.io and run it on
127.0.0.1:8182. It should not be reachable from outside the host: everything goes
through nginx, which is where authorisation happens.

In `cantaloupe.properties`:

    source.static = FilesystemSource
    FilesystemSource.lookup_strategy = ScriptLookupStrategy
    delegate_script.enabled = true
    delegate_script.pathname = /path/to/delegates.rb
    http.host = 127.0.0.1
    http.port = 8182
    endpoint.api.enabled = false

### 2. Install the delegate

`config/cantaloupe/delegates.rb` ships with this plugin. Copy it beside
Cantaloupe and point `delegate_script.pathname` at it.

Edit `INSTANCE_PATHS` at the top. The key is each site's hostname, the value the
directory `uploads/` sits inside, with a trailing slash. One image server usually
fronts several AtoM sites and the same identifier means a different file on each,
which is why it is a map rather than one path.

**This is the part that matters.** Without the delegate the image server reads
files straight off disk and knows nothing about AtoM's access control, so every
master under `uploads/r/` is retrievable through the IIIF endpoint by anyone who
can form the path - and those paths appear in every manifest. The nginx rules
protecting `/uploads/r/` do not help: it is a different route to the same bytes.

### 3. Proxy it from nginx

In the AtoM server block, before the main PHP handler:

    location /iiif/ {
        proxy_pass http://127.0.0.1:8182/iiif/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Access-Control-Allow-Origin "*" always;
    }

The `Host` header is not optional. The delegate asks AtoM whether a file may be
served, and it needs to know which site is asking; without it the check lands on
whichever vhost answers by default, which knows nothing about the file and allows
it.

A ready-made snippet is in the runtime at `config/nginx/extensions.conf`.

### 4. Prove it is actually refusing

    curl -sk -H "Host: <your-site>" \
      "https://127.0.0.1/iiif/auth/cantaloupe-check?identifier=<url-encoded-path>"

A master must answer `{"allowed": false}`. Then request the same master through
`/iiif/2/<identifier>/full/max/0/default.jpg` anonymously and confirm a 403.
Restart Cantaloupe first, because the delegate caches its verdicts.

`config/cantaloupe/README.md` covers three ways this can appear configured while
doing nothing at all - each failed silently and independently in practice. Read it
before putting an image server in front of a live collection.

## Uninstall
CANTALOUPE
) 
$( [ -d "$SRC/config/cantaloupe" ] || echo "## Uninstall" )

Disable in Admin > Plugins, in reverse order, then remove the directories and
clear the cache. The tables are left in place; drop them by hand if the data is
genuinely no longer wanted.

## Licence

$LICENCE. The Archive and Heritage Group (Pty) Ltd.
EOF
} > "$STAGE/INSTALL.md"

# ------------------------------------------------------------------ CSP check
#
# Style attributes are dropped outright by an enforcing Content Security Policy.
# AtoM ships style-src with a nonce and no 'unsafe-hashes', and a nonce cannot
# rescue an attribute - only <style> and <script> elements can carry one. So every
# style="..." in a template is a rule that will not apply on any site running the
# enforcing header, silently, with nothing logged.
#
# This is checked at build time because the alternative is finding out after
# publication, which is how it went: four plugins shipped before a run against an
# enforcing instance found them. The development instance sent
# Content-Security-Policy-Report-Only, which applies the styles anyway and reports
# nothing useful, so the test suite had been green throughout.
#
# Set AHG_ALLOW_INLINE_STYLES=1 to package anyway.
# Scoped to templates rendered inside AtoM. Export and report services generate
# standalone HTML or PDF that is never served under the site's policy, so style
# attributes there are legitimate and flagging them would only teach people to
# pass the override.
INLINE=0
INLINE_FILES=""
if [ -d "$STAGE/$PLUGIN/modules" ]; then
    # Every grep needs "|| true": it exits 1 when it finds nothing, and under
    # set -euo pipefail that aborts the build. Without this the check failed the
    # clean plugins and passed nothing - the opposite of its purpose - and it
    # published stale zips before anyone noticed.
    # The pattern excludes data-ahg-style="...", which legitimately carries a
    # declaration for the CSSOM applier to set. Matching bare 'style="' caught
    # those too and refused plugins that had already been fixed.
    INLINE_FILES="$(grep -rlE '(^|[^-[:alnum:]])style="[^"]*"' "$STAGE/$PLUGIN"/modules/*/templates --include='*.php' 2>/dev/null || true)"
    INLINE="$( { grep -rhoE '(^|[^-[:alnum:]])style="[^"]*"' "$STAGE/$PLUGIN"/modules/*/templates --include='*.php' 2>/dev/null || true; } | wc -l | tr -d ' ')"
fi

if [ "${INLINE:-0}" -gt 0 ]; then
    echo "" >&2
    echo "  REFUSING to package $PLUGIN: $INLINE inline style attribute(s)." >&2
    echo "" >&2
    echo "$INLINE_FILES" | sed "s|$STAGE/|    |" | head -10 >&2
    echo "" >&2
    echo "  A CSP nonce covers <style> and <script> elements, never a style" >&2
    echo "  attribute, so these are dropped on any site running the enforcing" >&2
    echo "  header. Use a class, or ahg_style_block() from ahgCorePlugin, or set" >&2
    echo "  the property through the CSSOM for a computed value." >&2
    echo "" >&2
    echo "  AHG_ALLOW_INLINE_STYLES=1 to package anyway." >&2
    echo "" >&2

    if [ "${AHG_ALLOW_INLINE_STYLES:-0}" != "1" ]; then
        exit 1
    fi
fi

# ------------------------------------------------------------------ package
ZIP="$OUTDIR/$PLUGIN-$VERSION.zip"
rm -f "$ZIP"
( cd "$STAGE" && zip -qr "$ZIP" . -x '*/.git/*' '*/node_modules/*' )

( cd "$OUTDIR" && sha256sum "$(basename "$ZIP")" > "$(basename "$ZIP").sha256" )

echo "  plugin  : $PLUGIN $VERSION"
echo "  deps    : ${DEPS:-none}"
echo "  tables  : $(echo "$TABLES" | grep -c . || echo 0)"
echo "  shots   : $( [ -d "$STAGE/screenshots" ] && ls "$STAGE/screenshots" | wc -l || echo 0)"
echo "  zip     : $ZIP ($(du -h "$ZIP" | cut -f1))"
echo "  sha256  : $(cut -d' ' -f1 "$ZIP.sha256")"
